{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "620px",
      "wideSize": "1000px"
    },
    "spacing": {
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "name": "System Font",
          "slug": "system-font"
        },
        {
          "fontFamily": "Manrope, sans-serif",
          "slug": "manrope",
          "name": "Manrope",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/Manrope-VariableFont_wght.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Fira Code', monospace",
          "slug": "fira-code",
          "name": "Fira Code",
          "fontFace": [
            {
              "fontFamily": "Fira Code",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "src": ["file:./assets/fonts/FiraCode-VariableFont_wght.woff2"]
            }
          ]
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "typography": {
      "fontFamily": "var:preset|font-family|manrope",
      "fontWeight": "400",
      "lineHeight": "2",
      "letterSpacing": "0.05rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "700",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.1"
        }
      },
      "h1": {
        "typography": {
          "fontWeight": "800"
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|manrope",
          "fontWeight": "800",
          "lineHeight": "1.1"
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header"
    },
    {
      "area": "footer",
      "name": "footer"
    }
  ],
  "version": 3
}
